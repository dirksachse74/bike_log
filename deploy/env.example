# deploy/.env — Bike Log server settings. install.sh writes this file for you; you only edit it to change
# something (then run: bikelog-update). Never commit it: it holds the Google client secret.

# Your domain (DNS A record points to this server). Caddy gets the HTTPS certificate for it.
BIKELOG_DOMAIN=bikelog.example.com
BIKELOG_PUBLIC_URL=https://bikelog.example.com

# Google sign-in: Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI there: https://bikelog.example.com/auth/callback
BIKELOG_GOOGLE_CLIENT_ID=
BIKELOG_GOOGLE_CLIENT_SECRET=

# Who may sign in: Google account e-mail addresses, separated by commas.
BIKELOG_ALLOWED_EMAILS=you@gmail.com

# Optional: days until you have to sign in again (default 30).
# BIKELOG_SESSION_DAYS=30
# Optional: time zone of the server clock in logs (the app itself uses Settings → Time zone).
# TZ=Europe/Berlin
